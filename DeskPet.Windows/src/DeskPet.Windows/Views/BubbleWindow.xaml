<Window x:Class="DeskPet.Windows.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bubble"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="200"
        SizeToContent="Height"
        SnapsToDevicePixels="True">
    <Grid>
        <Border x:Name="BubbleCard"
                Background="#F5FFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="UserTextBlock"
                           Text="{Binding UserText}"
                           FontSize="10"
                           Foreground="#99000000"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           Visibility="Collapsed"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="PetTextBlock"
                           Text="{Binding PetText}"
                           FontSize="12"
                           Foreground="#E6000000"
                           TextWrapping="Wrap"
                           MaxHeight="280" />
                <DockPanel x:Name="InputRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Content="✕"
                            Width="22"
                            Height="22"
                            Margin="4,0,0,0"
                            Padding="0"
                            FontSize="10"
                            ToolTip="关闭气泡"
                            Click="OnCloseClick" />
                    <Button x:Name="SendButton"
                            DockPanel.Dock="Right"
                            Content="发送"
                            Height="22"
                            Margin="4,0,0,0"
                            Padding="8,0"
                            FontSize="11"
                            IsEnabled="False"
                            Click="OnSendClick" />
                    <TextBox x:Name="InputTextBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             Padding="6,3"
                             Focusable="True"
                             KeyDown="OnInputKeyDown" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
